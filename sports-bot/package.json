{
  "name": "omnimod-sports-bot",
  "version": "6.0.0",
  "private": true,
  "description": "Offline-first, calibrated, multi-sport Discord prediction-assistance and evaluation bot.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node --import ./test/setup.js --test",
    "start": "node app.js",
    "start:cjs": "node app.cjs",
    "worker": "node src/index.js",
    "preview": "node src/preview.js",
    "preview:odds": "node src/preview.js --with-odds",
    "register": "node src/registerCommands.js",
    "audit:warehouse-results": "node scripts/review-warehouse-results.js",
    "audit:predictions": "node scripts/audit-predictions.js",
    "audit:evidence": "node scripts/audit-evidence.js",
    "audit:operations": "node scripts/audit-operations.js",
    "audit:prices": "node scripts/audit-prices.js",
    "audit:quote-attempts": "node scripts/audit-quote-attempts.js",
    "research:prospective": "node scripts/prospective-research.js",
    "research:selection": "node scripts/selection-research.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "undici": "6.28.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "undici": "6.28.1"
  }
}
