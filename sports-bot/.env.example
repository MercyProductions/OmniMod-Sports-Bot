# OmniMod Sports Discord bot
# Copy to .env or run scripts/setup-env.ps1.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional fallback IDs. Preferred setup is /sports setup inside Discord.
SPORTS_CHANNEL_ID=
SPORTS_RESULTS_CHANNEL_ID=
SPORTS_LOG_CHANNEL_ID=
SPORTS_NOTIFY_ROLE_ID=
SPORTS_ADMIN_ROLE_ID=

# Optional global fallback. Preferred setup is /sports api-key inside Discord.
ODDS_API_KEY="" # optional
ODDS_API_REGION=us
# npm run preview never uses this key unless you explicitly run npm run preview:odds.

TIMEZONE=America/Chicago
DAILY_POST_HOUR=8
DAILY_POST_MINUTE=0
POST_ON_START=true
FINAL_CHECK_MINUTES=10
# Recheck acknowledged finals for corrections; 0 hours disables these extra checks.
FINAL_CORRECTION_CHECK_HOURS=24
FINAL_CORRECTION_CHECK_MINUTES=60
# Revisit unresolved prior-date games after midnight; older outcomes remain pending for manual reconciliation.
FINAL_LOOKBACK_DAYS=7
REGISTER_COMMANDS=true

# Tune data volume.
MAX_GAMES_PER_POST=75
MAX_LEAGUES_PER_REFRESH=24

# Offline-first controls. LOCAL_ONLY=true disables scoreboard, enrichment, and odds network calls;
# import schedules/results with /sportsdata import when using strict local mode.
LOCAL_ONLY=false
SCOREBOARD_CACHE_MINUTES=10
SCOREBOARD_STALE_HOURS=48
ODDS_CACHE_HOURS=6
# Optional admin /sports value refresh:true: global HTTP request budget across guilds.
# Disabled by default. Each explicit refresh requests one selected league, h2h only.
SPORTS_VALUE_REFRESH_DAILY_CAP=0
SPORTS_VALUE_REFRESH_COOLDOWN_MINUTES=5
PREDICTION_HISTORY_DAYS=365
AUTO_ENRICH_ENABLED=true
AUTO_SUMMARY_MAX_GAMES=24
AUTO_SUMMARY_CACHE_MINUTES=180
AUTO_HISTORY_MAX_LEAGUES=10
AUTO_HISTORY_CACHE_HOURS=12
AUTO_HISTORY_MAX_DAYS=365
# Immutable historical boxes are cached for 30 days, so this is mainly a first-run cost.
AUTO_BOXSCORE_MAX_EVENTS=36
AUTO_BOXSCORE_CACHE_DAYS=30
AUTO_OFFICIAL_SOURCES=true
AUTO_LEARNING_ENABLED=true
AUTO_LEARNING_MIN_SAMPLES=30
DRIFT_RECENT_SAMPLES=30

# Pregame refreshes force only the due game's free event summary. They never
# consume another paid Odds API batch. Missed windows collapse into one refresh.
PREGAME_REFRESH_ENABLED=true
PREGAME_REFRESH_WINDOWS=90,30,10

# Durable local learning, chronological replay, and safe challenger promotion.
FEATURE_WAREHOUSE_ENABLED=true
HISTORICAL_REPLAY_ENABLED=true
HISTORICAL_REPLAY_MAX_ROWS=8000
CHALLENGER_MIN_SAMPLES=75
LOCAL_ML_ENABLED=true
LOCAL_ML_MIN_SAMPLES=150
PLAY_BY_PLAY_ENABLED=true
HORIZON_EVALUATION_ENABLED=true
SOURCE_REDUNDANCY_ENABLED=true

# Keyless, cached open-data snapshots (currently tennis metrics and the
# StatsBomb competition catalog). Failures retain the prior snapshot.
ADVANCED_DATASETS_ENABLED=true
ADVANCED_DATASET_SYNC_DAYS=7
# NBA.com advanced-team sync is implemented but off by default because its
# public endpoint frequently blocks server-hosted traffic. ESPN box-score
# possessions/efficiency remain available when this is false.
ADVANCED_NBA_STATS_ENABLED=false
